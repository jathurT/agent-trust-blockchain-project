#!/usr/bin/env bash
# Blocks commits that look like they contain a private key, mnemonic or .env file.
# Bypass (only with a very good reason): git commit --no-verify
set -uo pipefail
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
fail=0

# 1. never commit a .env (but .env.example is fine)
while IFS= read -r f; do
  case "$f" in
    *.env|*.env.*) [ "${f##*/}" = ".env.example" ] || { echo "BLOCKED: $f looks like an env file"; fail=1; };;
    *.key|*.pem)   echo "BLOCKED: $f looks like a key file"; fail=1;;
  esac
done <<< "$staged"

# 2. scan staged content for secrets
#    The Anvil/Hardhat public test mnemonic is explicitly allowed (test-only, never funded).
ALLOW_MNEMONIC='test test test test test test test test test test test junk'
added=$(git diff --cached -U0 | grep '^+' | grep -v '^+++' || true)
scan=$(printf '%s\n' "$added" | grep -v -F "$ALLOW_MNEMONIC" || true)

if printf '%s\n' "$scan" | grep -qE '(^|[^0-9a-fA-Fx])0x[a-fA-F0-9]{64}([^0-9a-fA-F]|$)'; then
  echo "BLOCKED: a 32-byte hex value that looks like a private key is staged"; fail=1
fi
if printf '%s\n' "$scan" | grep -qE 'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY'; then
  echo "BLOCKED: a PEM private key is staged"; fail=1
fi
if printf '%s\n' "$scan" | grep -qiE '(PRIVATE_KEY|MNEMONIC|SEED_PHRASE)[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9 ]{16,}'; then
  echo "BLOCKED: a PRIVATE_KEY/MNEMONIC assignment with a value is staged"; fail=1
fi

[ $fail -eq 0 ] || { echo; echo "Commit refused. Move the secret to .env (git-ignored) or a keystore."; exit 1; }
exit 0
