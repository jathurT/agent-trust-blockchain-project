# AgentTrust configuration — NAMES ONLY. Copy to .env and fill in locally.
# .env is git-ignored. Never put a private key or mnemonic in this file or in the repo.
# Keys belong in a Foundry keystore (`cast wallet import <name> --interactive`) or your
# OS keychain; scripts reference them by keystore name, never by value.

# ---- chain -------------------------------------------------------------------
RPC_URL=                 # e.g. https://sepolia.base.org (HTTP only; events are polled)
CHAIN_ID=                # 84532 testnet, 31337 local anvil
CONFIRMATIONS=           # 1 local, 3 testnet (DF-23)

# ---- deployed addresses (written by CONTRACT-017 into deployments/<network>.json) ----
ESCROW_ADDRESS=
USDC_ADDRESS=            # Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
IDENTITY_REGISTRY=
REPUTATION_REGISTRY=
VALIDATION_REGISTRY=

# ---- seller ------------------------------------------------------------------
SELLER_ORIGIN=           # canonical origin used for hashing, e.g. https://seller.example
                         # NEVER derived from the Host header (SPEC-001 §2.2)
SELLER_AGENT_ID=         # ERC-8004 agent id owned by the seller
SELLER_KEYSTORE=         # keystore account name, not a key
CLAIMS_DB_PATH=          # default $HOME/.local/state/agenttrust/claims.sqlite
                         # keep it off /mnt/* — writes there are ~38x slower (DF-20)
REPLAY_POLICY=           # idempotent (default) | strict — measurements use idempotent
ACCEPTED_VALIDATORS=     # comma-separated validator addresses the seller will serve under

# ---- buyer -------------------------------------------------------------------
BUYER_KEYSTORE=
TRUSTED_CLIENTS=         # comma-separated addresses whose ERC-8004 feedback the gate counts
MAX_PRICE_ATOMIC=        # refuse quotes above this, in atomic units

# ---- validator ---------------------------------------------------------------
VALIDATOR_URL=           # e.g. http://127.0.0.1:8088
VALIDATOR_KEYSTORE=
EVIDENCE_DIR=            # where delivered bytes are stored (VAL-002/006)

# ---- deployment / verification ----------------------------------------------
DEPLOYER_KEYSTORE=
ETHERSCAN_API_KEY=       # optional; Blockscout needs no key (DEPLOY-002)

# ---- extended scope only -----------------------------------------------------
LITELLM_BASE_URL=        # AGENT-005 (E2) only
